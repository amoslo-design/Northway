{
  "name": "northway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tokens": "python3 design/tokens/build.py",
    "test": "npm run test:content && playwright test",
    "test:content": "esbuild tests/content-states.tsx --bundle --jsx=automatic --platform=node --external:react --external:react-dom --external:next --external:@playwright/test --outfile=.cache/content-states.cjs --log-level=error && node --test .cache/content-states.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "eslint-config-next": {
      "@typescript-eslint/parser": "$@typescript-eslint/parser",
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
